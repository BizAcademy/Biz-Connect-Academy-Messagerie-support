# Node.js 22+; copy to .env for standalone use. Never commit the real .env.
NODE_ENV=production
PORT=3000
BASE_PATH=/
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# At least 32 random characters. Configure through Secrets on Replit.
SESSION_SECRET=
# Public HTTPS origin, no trailing slash
APP_ORIGIN=https://your-domain.example
# Persistent private disk, outside the website document root
STORAGE_DIR=/absolute/private/path/biz-connect-storage
# Optional independent file key. When blank, derived from SESSION_SECRET.
FILE_ENCRYPTION_KEY=
# Public contact URL or mailto: address for push delivery
VAPID_SUBJECT=mailto:your-support@your-domain.example
# Optional explicit VAPID keypair; when blank, derived from SESSION_SECRET.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FFPROBE_PATH=ffprobe
ENABLE_DEMO=false
# Only needed while invoking the admin seed, then remove
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Only needed while explicitly provisioning a member
MEMBER_USERNAME=
MEMBER_NUMBER=
MEMBER_PHONE=
