# Configure in Plesk > Node.js > Custom environment variables, or in plesk/.env.
# Never commit a real .env. Secrets saved in Replit are NOT transferred by Git.
NODE_ENV=production
APP_ORIGIN=https://votre-domaine.example
SESSION_SECRET=
# Private persistent storage is created automatically outside the Git checkout.
# No STORAGE_DIR configuration is required. Preserve the application root and
# generated private directory across updates; back up this directory with the DB.

# Cybrancee: MySQL / MariaDB. Four required fields; port defaults to 3306.
# localhost is valid only when the database runs on the same host as this app.
CYBRANCEE_DB_HOST=
CYBRANCEE_DB_NAME=
CYBRANCEE_DB_USER=
CYBRANCEE_DB_PASSWORD=
# Optional, only if Cybrancee specifies a nonstandard port:
# CYBRANCEE_DB_PORT=3306
# Alternatively, omit all CYBRANCEE_DB_* variables and set:
# DATABASE_URL=mysql://USER:PASSWORD@HOST/DATABASE
# PostgreSQL development compatibility is retained with a postgresql:// URL.

# Stable key: do not rotate SESSION_SECRET / FILE_ENCRYPTION_KEY without planning
# re-encryption of existing private files.
FILE_ENCRYPTION_KEY=
VAPID_SUBJECT=mailto:support@votre-domaine.example
FFPROBE_PATH=ffprobe
