{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/install-workspace.mjs",
    "start": "node scripts/start.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build:plesk": "node scripts/build-plesk.mjs",
    "verify:plesk": "node plesk/verify.cjs --sources",
    "test:plesk": "node scripts/test-plesk.mjs",
    "test:mysql": "node scripts/test-mysql.mjs",
    "seed": "pnpm --filter @workspace/api-server run seed",
    "seed:demo": "pnpm --filter @workspace/api-server run seed:demo",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": { "node": ">=22.0.0" },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
